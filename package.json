{
  "name": "daily-arxiv-math",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "security:check": "node scripts/check_secrets.mjs",
    "test": "node scripts/run_tests.mjs",
    "static:sync": "tsx scripts/sync_static_mirror.ts",
    "static:build": "tsx scripts/build_static_pages.ts",
    "static:check": "astro check --root static-site",
    "ci": "npm run lint && npm run typecheck && npm test && npm run static:check && npm run security:check"
  },
  "dependencies": {
    "katex": "^0.18.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "astro": "7.3.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "type": "module"
}
