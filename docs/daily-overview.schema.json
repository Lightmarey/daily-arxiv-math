{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lightmarey/daily-arxiv-math/blob/main/docs/daily-overview.schema.json",
  "title": "Daily overview sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["announcementDate", "resultItems", "noteworthyItems"],
  "properties": {
    "announcementDate": {
      "type": "string",
      "format": "date"
    },
    "resultItems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analysisId", "text"],
        "properties": {
          "analysisId": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "noteworthyItems": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analysisId", "result", "significance"],
        "properties": {
          "analysisId": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1, "maxLength": 140 },
          "significance": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
