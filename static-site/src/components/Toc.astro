---
import type { StaticDayV3, StaticMirrorManifestV3 } from '../../../lib/static-mirror';
import { reportAnchor } from '../lib/runtime';

interface Props {
  day: StaticDayV3;
  manifest: StaticMirrorManifestV3;
}

const { day, manifest } = Astro.props;
const categories = manifest.config.categories.filter((category) =>
  manifest.config.displayCategories.includes(category.id),
);
const categoryOrder = new Map(categories.map((category, index) => [category.id, index]));
const reports = [...day.analyses]
  .filter((report) => categoryOrder.has(report.categoryId))
  .sort(
    (left, right) =>
      categoryOrder.get(left.categoryId)! - categoryOrder.get(right.categoryId)! ||
      right.priorityScore - left.priorityScore ||
      left.arxivId.localeCompare(right.arxivId),
  );
---

<aside class="toc" aria-label="本页目录">
  <details open data-toc>
    <summary>目录</summary>
    <nav>
      {
        reports.map((report) => (
          <a
            href={`#${reportAnchor(report)}`}
            data-toc-paper
            data-report-target={reportAnchor(report)}
          >
            {report.title}
          </a>
        ))
      }
    </nav>
  </details>
</aside>
