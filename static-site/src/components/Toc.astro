---
import type { StaticDayV4, StaticMirrorManifestV4 } from '../../../lib/static-mirror';
import { categoryAnchor, reportAnchor, topicAnchor } from '../lib/runtime';

interface Props {
  day: StaticDayV4;
  manifest: StaticMirrorManifestV4;
}

const { day, manifest } = Astro.props;
const categories = manifest.config.categories.filter((category) =>
  manifest.config.displayCategories.includes(category.id),
);
const ordered = (reports: StaticDayV4['analyses']) =>
  [...reports].sort(
    (left, right) =>
      right.priorityScore - left.priorityScore || left.arxivId.localeCompare(right.arxivId),
  );
---

<aside class="toc" aria-label="本页目录">
  <details open data-toc>
    <summary>目录</summary>
    <nav>
      <ul class="toc-fields">
        {
          categories.map((category) => {
            const categoryReports = day.analyses.filter(
              (report) => report.categoryId === category.id,
            );
            if (!categoryReports.length) return null;
            return (
              <li data-toc-category>
                <a href={`#${categoryAnchor(category.id)}`}>{category.id}</a>
                <ul>
                  {category.topics.map((topic) => {
                    const reports = ordered(
                      categoryReports.filter((report) => report.topicId === topic.id),
                    );
                    if (!reports.length) return null;
                    return (
                      <li data-toc-topic>
                        <a href={`#${topicAnchor(category.id, topic.id)}`}>{topic.label}</a>
                        <ul>
                          {reports.map((report) => (
                            <li
                              data-toc-paper
                              data-report-target={reportAnchor(report)}
                            >
                              <a href={`#${reportAnchor(report)}`}>{report.title}</a>
                            </li>
                          ))}
                        </ul>
                      </li>
                    );
                  })}
                </ul>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </details>
</aside>
