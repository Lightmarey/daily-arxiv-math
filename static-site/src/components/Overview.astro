---
import {
  canonicalDailyReports,
  dailyTopicCounts,
  type StaticDayV4,
} from '../../../lib/static-mirror';
import type { PublicTrackingConfig } from '../../../lib/config';
import { reportAnchor } from '../lib/runtime';
import MathText from './MathText.astro';

interface Props {
  day: StaticDayV4;
  config: PublicTrackingConfig;
}

const { day, config } = Astro.props;
const canonicalReports = canonicalDailyReports(day.analyses);
const topicCounts = dailyTopicCounts(day.analyses, config);
const reportsById = new Map(day.analyses.map((report) => [report.id, report]));
const reportFor = (analysisId: string) => {
  const report = reportsById.get(analysisId);
  if (!report) throw new Error(`Missing overview report ${analysisId}`);
  return report;
};
const overviewText = (value: string) =>
  value.trim().replace(/[。；;，,、]+$/u, '');
---

<section class="overview" id="overview">
  <header class="overview-head">
    <h1>当日总览</h1>
    <div class="status-badges" aria-label="日报状态">
      <span>完整收敛 {day.coverage.publishedCount}/{day.coverage.expectedCount}</span>
      <span>AI 协作 {day.aiDisclosureCount}</span>
    </div>
  </header>
  <div class="overview-summary">
    <p class="overview-lead">
      今日共收录 {canonicalReports.length} 篇论文{
        topicCounts.length > 0 && '，其中 '
      }{
        topicCounts.map((group, groupIndex) => (
          <>
            {groupIndex > 0 && '；'}
            {group.categoryId} 涉及{
              group.topics.map((topic, topicIndex) => (
                <>
                  {topicIndex > 0 && '、'}
                  {topic.label}（{topic.count} 篇）
                </>
              ))
            }
          </>
        ))
      }。
    </p>
    <p>
      今天的结果包括{
        day.dailyOverview.resultItems.map((item, index) => {
          const report = reportFor(item.analysisId);
          return (
            <>
              {index > 0 && '、'}
              <a href={`#${reportAnchor(report)}`} data-overview-result-link>
                <MathText value={overviewText(item.text)} inline />
              </a>
            </>
          );
        })
      }。
    </p>
    {
      day.dailyOverview.noteworthyItems.length > 0 && (
        <p>
          值得一看的是，{
            day.dailyOverview.noteworthyItems.map((item, index) => {
              const report = reportFor(item.analysisId);
              const abstractOnly = report.analysisDepth === 'abstract';
              return (
                <>
                  {index > 0 && '；此外，'}
                  {abstractOnly && '论文声称'}
                  <a href={`#${reportAnchor(report)}`} data-overview-noteworthy-link>
                    <MathText value={overviewText(item.result)} inline />
                  </a>
                  ；{abstractOnly && '若成立，'}
                  <MathText value={overviewText(item.significance)} inline />
                </>
              );
            })
          }。
        </p>
      )
    }
  </div>
</section>
