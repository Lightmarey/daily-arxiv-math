---
import DayPage from '../components/DayPage.astro';
import Layout from '../layouts/Layout.astro';
import { loadStaticContent } from '../lib/content';

const { manifest, volume, days } = await loadStaticContent();
const day = days.find(
  (entry) => entry.announcementDate === manifest.latestDate,
);
if (!day) throw new Error(`Missing latest static day ${manifest.latestDate}`);
---

<Layout
  title={`${day.announcementDate} · ${manifest.config.site.name}`}
  description={manifest.config.site.description}
  siteName={manifest.config.site.name}
>
  <DayPage day={day} manifest={manifest} volume={volume} />
</Layout>
