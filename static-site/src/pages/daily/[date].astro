---
import type { GetStaticPaths } from 'astro';
import DayPage from '../../components/DayPage.astro';
import TopControls from '../../components/TopControls.astro';
import Layout from '../../layouts/Layout.astro';
import { loadStaticContent } from '../../lib/content';

export const getStaticPaths = (async () => {
  const { manifest, volume, days } = await loadStaticContent();
  return days.map((day) => ({
    params: { date: day.announcementDate },
    props: { day, manifest, volume },
  }));
}) satisfies GetStaticPaths;

const { day, manifest, volume } = Astro.props;
---

<Layout
  title={`${day.announcementDate} · Arxiv日报`}
  description={manifest.config.site.description}
>
  <TopControls slot="header-controls" day={day} manifest={manifest} />
  <DayPage day={day} manifest={manifest} volume={volume} />
</Layout>
